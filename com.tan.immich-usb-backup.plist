<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tan.immich-usb-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/tan/server/immich-app/backup-immich-usb.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/tan/server/immich-app</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/tan/server/immich-app/logs/immich-usb-backup.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/tan/server/immich-app/logs/immich-usb-backup.log</string>
</dict>
</plist>
